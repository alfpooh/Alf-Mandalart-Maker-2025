# Copy to .env.local and fill in. Never commit .env.local.

# --- AI -------------------------------------------------------------------
# Groq is the current provider. Switching means adding the provider to
# PROVIDERS in lib/ai/models.ts and setting AI_PROVIDER — no call site changes.
GROQ_API_KEY=

# Optional. Defaults live in lib/ai/models.ts.
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b            # default for every task

# Per-task overrides. Dependency analysis and whole-plan review already run on
# gpt-oss-120b because they need real reasoning; the rest run on 20b.
# Only the gpt-oss family supports the JSON-schema structured output this app
# relies on — qwen and the compound models return 400.
# AI_MODEL_SUBGOALS=
# AI_MODEL_ACTIONS=
# AI_MODEL_REFINE=
# AI_MODEL_DEPENDENCIES=
# AI_MODEL_PROGRESS=
# AI_MODEL_REVIEW=

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's "publishable" key (sb_publishable_...). It replaced the key that
# used to be called `anon`, which the variable name still reflects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase's "secret" key (sb_secret_...), formerly `service_role`.
# Server only. Bypasses row level security — it reads anonymous drafts by
# token and enforces the quota, neither of which a policy can do. Must never
# reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anonymous quota ------------------------------------------------------
# Salt for hashing client IPs. Any long random string; changing it resets
# everyone's daily count. The raw IP is never stored.
ANON_QUOTA_SALT=

# Mandalarts per day for anonymous visitors. The first is often spent working
# out what the tool does, so one is enough to try it but not to use it.
# ANON_DAILY_LIMIT=2

# Signed-in accounts. One plan is ~17 model calls, so this is not unbounded.
# USER_DAILY_LIMIT=10

# Model calls in flight at once. Groq's free tier allows 8,000 tokens/minute
# and one plan needs roughly 15,000 across its eight area calls, so firing them
# all together makes several fail. Raise this on a paid tier.
# AI_CONCURRENCY=2
