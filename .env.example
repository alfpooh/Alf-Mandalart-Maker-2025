# Copy to .env.local and fill in. Never commit .env.local.

# --- AI -------------------------------------------------------------------
# Groq is the current provider. Switching means adding the provider to
# PROVIDERS in lib/ai/models.ts and setting AI_PROVIDER — no call site changes.
GROQ_API_KEY=

# Optional. Defaults live in lib/ai/models.ts.
# AI_PROVIDER=groq
# AI_MODEL=llama-3.1-8b-instant          # default for every task

# Per-task overrides. Dependency analysis and whole-plan review are the two
# jobs that most need reasoning — raise just these if 8B proves too weak,
# rather than moving everything.
# AI_MODEL_SUBGOALS=
# AI_MODEL_ACTIONS=
# AI_MODEL_REFINE=
# AI_MODEL_DEPENDENCIES=
# AI_MODEL_PROGRESS=
# AI_MODEL_REVIEW=

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security — it reads anonymous drafts by
# token and enforces the quota, neither of which a policy can do. Must never
# reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anonymous quota ------------------------------------------------------
# Salt for hashing client IPs. Any long random string; changing it resets
# everyone's daily count. The raw IP is never stored.
ANON_QUOTA_SALT=

# One Mandalart per day for anonymous visitors.
# ANON_DAILY_LIMIT=1
