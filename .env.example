# Copy to .env.local and fill in. Never commit .env.local.

# --- AI -------------------------------------------------------------------
# Google Gemini is the current provider. Get a key at
# https://aistudio.google.com/apikey — this exact variable name is what the
# AI SDK's Google provider reads, so do not rename it.
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq is still wired up as a fallback; set AI_PROVIDER=groq to switch back.
# Adding a third provider is one entry in PROVIDERS in lib/ai/models.ts plus
# its @ai-sdk/* package — no call site changes.
# GROQ_API_KEY=

# Optional. Defaults live in lib/ai/models.ts.
# AI_PROVIDER=google                     # or: groq
# AI_MODEL=gemini-flash-latest           # default for every task

# Per-task overrides. Dependency analysis and whole-plan review run on
# gemini-pro-latest because they need real reasoning; the rest run on flash.
# The `-latest` aliases follow Google's current model of each class. Pin an
# exact id here when a specific version matters.
# AI_MODEL_SUBGOALS=
# AI_MODEL_ACTIONS=
# AI_MODEL_REFINE=
# AI_MODEL_DEPENDENCIES=
# AI_MODEL_PROGRESS=
# AI_MODEL_REVIEW=

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase's "publishable" key (sb_publishable_...). It replaced the key that
# used to be called `anon`, which the variable name still reflects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase's "secret" key (sb_secret_...), formerly `service_role`.
# Server only. Bypasses row level security — it reads anonymous drafts by
# token and enforces the quota, neither of which a policy can do. Must never
# reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anonymous quota ------------------------------------------------------
# Salt for hashing client IPs. Any long random string; changing it resets
# everyone's daily count. The raw IP is never stored.
ANON_QUOTA_SALT=

# Mandalarts per day for anonymous visitors. The first is often spent working
# out what the tool does, so one is enough to try it but not to use it.
# ANON_DAILY_LIMIT=2

# Signed-in accounts. One plan is ~17 model calls, so this is not unbounded.
# USER_DAILY_LIMIT=10

# Model calls in flight at once. A plan's eight area calls fired together
# exceed what a free tier allows per minute, so several fail; queueing them
# two at a time finishes slower but finishes. Raise this on a paid tier.
# AI_CONCURRENCY=2
